# --- Supabase (ya lo tenías) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable

# --- Facturación electrónica ARCA (solo servidor: NO llevan NEXT_PUBLIC_) ---
# Clave "service_role" (o "secret") de Supabase: Project Settings → API. Se usa para guardar claves cifradas y tickets de ARCA.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
# 32 bytes aleatorios en base64. Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: si la perdés hay que generar de nuevo los certificados de cada empresa.
ARCA_ENCRYPTION_KEY=

# Opcionales
# ARCA_TLS_LEGACY=1          # solo si Node rechaza el TLS de ARCA ("dh key too small")
# ARCA_WSAA_URL_HOMO=  ARCA_WSAA_URL_PROD=  ARCA_WSFE_URL_HOMO=  ARCA_WSFE_URL_PROD=   # para cambiar los endpoints si ARCA los migra
