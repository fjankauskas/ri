# --- Supabase (ya lo tenías) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable

# --- Facturación electrónica ARCA (solo servidor: NO llevan NEXT_PUBLIC_) ---
# Clave "service_role" (o "secret") de Supabase: Project Settings → API. Se usa para guardar claves cifradas y tickets de ARCA.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
# 32 bytes aleatorios en base64. Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: si la perdés hay que generar de nuevo los certificados de cada empresa.
ARCA_ENCRYPTION_KEY=

# Opcionales
# ARCA_TLS_LEGACY=1          # solo si Node rechaza el TLS de ARCA ("dh key too small")
# ARCA_WSAA_URL_HOMO=  ARCA_WSAA_URL_PROD=  ARCA_WSFE_URL_HOMO=  ARCA_WSFE_URL_PROD=   # para cambiar los endpoints si ARCA los migra

# --- Catálogo público de Open Food Facts ---
# Email de contacto que se envía en el User-Agent (lo pide Open Food Facts; sin él no se hacen consultas externas)
OFF_CONTACT_EMAIL=mseitsolutions@gmail.com
# Opcionales:
# OFF_APP_NAME=RedDeInventario
# OFF_FIELDS=product_name,generic_name,brands,quantity     # campos descriptivos que se guardan
# OFF_PRODUCT_RPM=60                                       # tope propio de consultas por minuto (OFF permite 100)
# OFF_NEG_TTL_DAYS=7                                       # cuánto se recuerda que OFF no tiene un código
# OFF_BATCH_SIZE=1000                                      # registros por lote en la importación
# OFF_FULL_REFRESH_DAYS=30                                 # cada cuánto repetir la importación completa
# OFF_EXPORT_CSV_URL=                                      # si se verifica un CSV filtrado por país
# OFF_ALERT_WEBHOOK_URL=                                   # aviso de alertas (texto JSON {text})

